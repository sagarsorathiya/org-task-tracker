# Next.js
NEXTAUTH_URL=http://localhost:4000
PORT=4000
NEXTAUTH_SECRET=CHANGE_THIS_TO_64_CHAR_RANDOM_STRING
AUTH_TRUST_HOST=true
NODE_ENV=production

# PostgreSQL
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=organization_tracker
PG_USER=organization_app
PG_PASSWORD=changeme
PG_SSL=false

# Active Directory LDAP
LDAP_URL=ldap://10.0.0.1:389
LDAP_BASE_DN=DC=organization,DC=local
LDAP_BIND_DN=CN=svc_tracker,OU=ServiceAccounts,DC=organization,DC=local
LDAP_BIND_PASSWORD=changeme

# Local Admin (not an AD account)
LOCAL_ADMIN_USERNAME=admin
LOCAL_ADMIN_PASSWORD=changeme

# SMTP Email
SMTP_HOST=some
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@organization.local

# WhatsApp via WAHA
WAHA_BASE_URL=http://localhost:3001
WAHA_SESSION=default
WAHA_API_KEY=

# Feature Flags
DEMO_LOGIN_ENABLED=false
REMINDER_SCHEDULER_ENABLED=true
REMINDER_CRON=0 9 * * *

# Domain SSO (IIS/Kerberos/NTLM)
SSO_ENABLED=false
SSO_AUTO_LOGIN=false
SSO_IDENTITY_HEADER=x-forwarded-user
SSO_ALLOWED_DOMAINS=
SSO_PROXY_SECRET_HEADER=x-sso-proxy-secret
SSO_PROXY_SHARED_SECRET=
# Known only to the IIS auth bridge (_authbridge/negotiate.aspx), which calls
# /api/sso/ticket over loopback. Must NOT equal SSO_PROXY_SHARED_SECRET: IIS
# injects that one onto every proxied request, so it cannot prove a caller is
# the bridge rather than an anonymous internet client.
SSO_BRIDGE_SHARED_SECRET=

# CORS / Network
CORS_ORIGINS=http://localhost:4000
CORS_ALLOW_PRIVATE_NETWORK=true
